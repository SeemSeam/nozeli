+/**
+ * Nozeli managed-collab inbound action gate v4 (OMP integration unit).
+ *
+ * Round-4 restructure (executor review job_a189516cbef4): one minimal state
+ * machine, explicit transition table, authoritative records own their facts.
+ *
+ * ── Entities ────────────────────────────────────────────────────────────────
+ * LedgerRecord  authoritative per admitted action: immutable identity
+ *               (rid/kind/at/ar/dg/ep) + append-only fact list + state.
+ *               Facts always carry the record's ORIGINAL ep/ar — they are
+ *               never re-ep'd, and query() is a pure read (no fact creation).
+ * Ledger        session-scoped, never evicted: pending | admitted | unknown.
+ *               Definitive non-admission rejections RELEASE the record to the
+ *               cache immediately (counterexample A); unknown stays held.
+ * ReceiptCache  per-epoch LRU over RELEASED records only (pure query).
+ * Watermark     session-scoped strictly-monotonic attempt fence.
+ * TurnOwnership authoritative {active, generation, requestRid}: the host binds
+ *               the dispatching rid explicitly (beginDispatch); agent_end with
+ *               willContinue/awaitingAsyncWork does not end a turn; an abort
+ *               may act only while active && generation matches && the target
+ *               owns the turn (no "most recent" guessing).
+ * Attachments   ingest-budgeted upload registry with atomic peek/commit:
+ *               nothing is consumed by rejected/busy/duplicate/missing
+ *               requests; mixing refs with inline images is rejected.
+ *
+ * ── Prompt transition table ─────────────────────────────────────────────────
+ *   (shape/perm/epoch/dedup/fence/adjudicator pass)
+ *   reserved --confirm(dg match)--> pending --onPromptAdmitted--> admitted
+ *   reserved --confirm(mismatch)--> released[rejected digest-mismatch]
+ *   pending  --busy*-->            released[rejected busy]      (definitive)
+ *   pending  --false w/o fact-->   released[rejected not-dispatched]
+ *   pending/admitted --error-->    unknown (held; quarantines prompts)
+ *   admitted --turn end-->         released (facts end at admitted; the
+ *                                  gateway reconciles via its terminal facts)
+ *   unknown  --resolve(evidence)--> released[<verified outcome>]
+ *
+ * ── Abort transition table ──────────────────────────────────────────────────
+ *   pending --executed(active,gen ok)--> released[executed]
+ *   pending --stale target/gen-->       released[rejected stale-target*]
+ *   pending --error-->                   unknown (held; resolvable)
+ *   unknown  --resolve(evidence)-->      released[<verified outcome>]
+ *
+ * Adjudicator seam: synchronous CommonJS module (createRequire) exporting
+ * admitAction(); ANY exception ⇒ deny with no side effects (it runs before
+ * the placeholder). The P1 persistent Controller grants admission out-of-band
+ * into a host-refreshed grant table this module consults; absence/expiry ⇒
+ * deny. A write token plus this gate is transport admission only.
+ */
+
+import { createHash } from "node:crypto";
+
+export type NozeliActionKind = "prompt" | "abort";
+export type NozeliReceiptStatus = "rejected" | "pending" | "admitted" | "executed" | "unknown";
+
+export interface NozeliActionReceipt {
+	t: "action-receipt";
+	rid: string;
+	kind: NozeliActionKind;
+	status: NozeliReceiptStatus;
+	reason?: string;
+	seq: number;
+	ep: string;
+	ar?: string;
+}
+
+export interface NozeliImage {
+	type: string;
+	mimeType?: string;
+	data?: string;
+}
+
+export interface NozeliAdmitInput {
+	kind: NozeliActionKind;
+	rid: string | undefined;
+	/** Sender-declared payload digest; bound into the immutable envelope. */
+	dg: string | undefined;
+	at: number | undefined;
+	ep: string | undefined;
+	ar: string | undefined;
+	tr?: string;
+	canWrite: boolean;
+	busy: boolean;
+}
+
+export interface NozeliAdmitDecision {
+	/** "reject": terminal rejection fact delivered. "replay": original facts. */
+	decision: "reject" | "replay" | "reserved";
+	receipt: NozeliActionReceipt;
+	receipts?: NozeliActionReceipt[];
+}
+
+export type NozeliSettleStatus = "admitted" | "executed" | "unknown";
+
+export type NozeliQueryResult =
+	| { status: "ok"; receipts: NozeliActionReceipt[] }
+	| { status: "forgotten" };
+
+export interface NozeliAdjudicator {
+	admitAction(request: {
+		kind: NozeliActionKind;
+		rid: string;
+		ep: string;
+		admissionRef: string | undefined;
+		contentDigest?: string;
+		attempt?: number;
+		targetTurn?: string | null;
+	}): { decision: "allow" | "deny"; reason?: string };
+}
+
+const RID_PATTERN = /^[A-Za-z0-9_-]{8,128}$/;
+const BASE64_PATTERN = /^[A-Za-z0-9+/]*={0,2}$/;
+
+export function isNozeliManagedCollab(): boolean {
+	return process.env.NOZELI_MANAGED_COLLAB === "1";
+}
+
+/** Canonical structured payload digest; invalid payloads return null. */
