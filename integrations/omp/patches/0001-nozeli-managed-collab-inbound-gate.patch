+
+type RecordState = "reserved" | "pending" | "admitted" | "unknown";
+
+/**
+ * Immutable payload descriptor captured at admission: binds the exact text,
+ * every ordered attachment's identity/digest/mime/length, and the canonical
+ * whole-payload digest. Replays compare against the descriptor with ZERO
+ * reassembly or consumption; a missing descriptor makes the replay
+ * unverifiable (rejected), never an excuse to skip verification.
+ */
+export interface NozeliPayloadDescriptor {
+	textDigest: string;
+	refs: ReadonlyArray<{ up: string; contentDigest: string; mimeType: string; length: number }>;
+	canonicalDigest: string;
+	inlineDigests: ReadonlyArray<string>;
+	target: string | null;
+}
+
+interface LedgerRecord {
+	rid: string;
+	kind: NozeliActionKind;
+	at: number;
+	ar: string | undefined;
+	ep: string;
+	/** Sender-declared digest captured at reservation (immutable). */
+	senderDg: string | undefined;
+	/** Confirmed actual digest (set by confirm; immutable afterwards). */
+	dg: string | undefined;
+	/** Immutable payload descriptor (set at confirm; authoritative for replays). */
+	descriptor: NozeliPayloadDescriptor | undefined;
+	state: RecordState;
+	facts: NozeliActionReceipt[];
+	abortGeneration?: number;
+	abortTarget?: string;
+}
+
+export interface NozeliAdmission {
+	epoch(): string;
+	beginEpoch(epoch: string): void;
+	admit(input: NozeliAdmitInput): NozeliAdmitDecision;
+	/** Second phase: verify the guest digest and freeze the payload descriptor. */
+	confirm(rid: string, dg: string, actualDg: string | null, descriptor?: NozeliPayloadDescriptor): NozeliActionReceipt | null;
+	/** Third phase: host adjudication of the fully validated request. */
+	adjudicate(rid: string): NozeliActionReceipt | null;
+	markAdmitted(rid: string): NozeliActionReceipt | null;
+	settle(rid: string, status: NozeliSettleStatus | "rejected", reason?: string): NozeliActionReceipt | null;
+	query(rid: string): NozeliQueryResult;
+	/**
+	 * Replay verification against the ORIGINAL immutable descriptor: the caller
+	 * supplies the current request's text digest and ordered ref names (plus
+	 * inline image digests when inline). Everything else — canonical digest,
+	 * per-ref content digest/mime/length — comes from the stored descriptor,
+	 * NEVER from live (possibly consumed) uploads. A missing descriptor is
+	 * "unverifiable" (reject), never a skip.
+	 */
+	verifyReplay(rid: string, probe: {
+		textDigest: string;
+		refNames: ReadonlyArray<string>;
+		inlineDigests: ReadonlyArray<string>;
+		target?: string | null;
+	}): { ok: boolean; reason?: string };
+	/** Host binds the dispatching request to the turn that is starting. */
+	beginDispatch(rid: string): void;
+	onTurnStart(): void;
+	onTurnEnd(): void;
+	/** Abort may act only on the authoritative active turn at the exact generation. */
+	abortTargetStale(rid: string): boolean;
+	resolveUnknown(rid: string, evidence: { admissionRef: string; ep: string; outcome: "not-executed" | "executed" }): NozeliActionReceipt | null;
+}
+
+/**
+ * Build the immutable payload descriptor from the confirmed payload pieces.
+ * Attachment digests are per-upload content hashes (not the raw bytes), so the
+ * descriptor stays bounded regardless of payload size.
+ */
+export function nozeliPayloadDescriptor(
+	text: string,
+	refs: ReadonlyArray<{ up: string; contentDigest: string; mimeType: string; length: number }>,
+	canonicalDigest: string,
+	images: ReadonlyArray<NozeliImage> = [],
+	target: string | null = null,
+): NozeliPayloadDescriptor {
+	const textDigest = createHash("sha256").update(text).digest("hex");
+	return Object.freeze({
+		textDigest,
+		refs: Object.freeze(refs.map(ref => Object.freeze({ ...ref }))),
+		canonicalDigest,
+		inlineDigests: Object.freeze(nozeliInlineDigests(images)),
+		target,
+	});
+}
+
+/** Hash complete validated inline image values, including MIME and ordering. */
+export function nozeliInlineDigests(images: ReadonlyArray<NozeliImage>): string[] {
+	return images.map(image => createHash("sha256").update(JSON.stringify({
+		type: image.type,
+		mimeType: image.mimeType,
+		data: image.data,
+	})).digest("hex"));
+}
+
