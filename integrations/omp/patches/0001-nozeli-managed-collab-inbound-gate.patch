+/**
+ * Chunked attachment registry with INGEST budgets and atomic peek/commit.
+ * Budgets are enforced when chunks arrive (total resident bytes/uploads), not
+ * only at take; base64 validity is checked per chunk; peek never consumes;
+ * commit deletes exactly the peeks an accepted request performed.
+ */
+export interface NozeliAttachment {
+	type: "image";
+	mimeType: string;
+	data: string;
+}
+
+interface UploadState {
+	mimeType: string;
+	parts: string[];
+	bytes: number;
+	closed: boolean;
+	uploadedAt: number;
+}
+
+export class NozeliAttachmentBuffer {
+	readonly #epochs = new Map<string, { uploads: Map<string, UploadState>; residentBytes: number; used: Set<string> }>();
+	readonly #maxChunkBytes: number;
+	readonly #maxUploadBytes: number;
+	readonly #maxUploads: number;
+	readonly #maxResidentBytes: number;
+	readonly #ttlMs: number;
+
+	constructor(options: { maxChunkBytes?: number; maxUploadBytes?: number; maxUploads?: number; maxResidentBytes?: number; ttlMs?: number } = {}) {
+		this.#maxChunkBytes = options.maxChunkBytes ?? 1_048_576;
+		this.#maxUploadBytes = options.maxUploadBytes ?? 33_554_432;
+		this.#maxUploads = options.maxUploads ?? 128;
+		this.#maxResidentBytes = options.maxResidentBytes ?? 67_108_864;
+		this.#ttlMs = options.ttlMs ?? 300_000;
+	}
+
+	#slot(ep: string): { uploads: Map<string, UploadState>; residentBytes: number; used: Set<string> } {
+		let slot = this.#epochs.get(ep);
+		if (!slot) {
+			slot = { uploads: new Map(), residentBytes: 0, used: new Set() };
+			this.#epochs.set(ep, slot);
+		}
+		return slot;
+	}
+
+	#gc(slot: { uploads: Map<string, UploadState>; residentBytes: number }, now: number): void {
+		for (const [up, state] of slot.uploads) {
+			if (now - state.uploadedAt < this.#ttlMs) continue;
+			slot.residentBytes -= state.bytes;
+			slot.uploads.delete(up);
+		}
+	}
+
+	beginEpoch(ep: string): void {
+		for (const key of this.#epochs.keys()) if (key !== ep) this.#epochs.delete(key);
+	}
+
+	open(ep: string, up: string, mimeType: string): "ok" | "duplicate" | "invalid" | "over-upload-count" {
+		if (up.length === 0 || mimeType.length === 0) return "invalid";
+		const slot = this.#slot(ep);
+		this.#gc(slot, Date.now());
+		// Upload IDs are immutable identities for this room epoch, including
+		// after commit/TTL collection. Bounded tombstones prevent name reuse
+		// from substituting new bytes beneath an admitted request's refs.
+		if (slot.used.has(up)) return "duplicate";
+		if (slot.used.size >= this.#maxUploads) return "over-upload-count";
+		slot.used.add(up);
+		slot.uploads.set(up, { mimeType, parts: [], bytes: 0, closed: false, uploadedAt: Date.now() });
+		return "ok";
+	}
+
+	chunk(ep: string, up: string, data: string): "ok" | "unknown-upload" | "closed" | "invalid-base64" | "over-chunk-budget" | "over-upload-budget" | "over-resident-budget" {
+		const slot = this.#slot(ep);
+		const upload = slot.uploads.get(up);
+		if (!upload) return "unknown-upload";
+		if (upload.closed) return "closed";
+		if (data.length === 0 || !BASE64_PATTERN.test(data) || data.length % 4 !== 0) return "invalid-base64";
+		if (data.length > this.#maxChunkBytes) return "over-chunk-budget";
+		if (upload.parts.length >= Math.ceil(this.#maxUploadBytes / this.#maxChunkBytes)) return "over-upload-budget";
+		if (upload.bytes + data.length > this.#maxUploadBytes) return "over-upload-budget";
+		// INGEST aggregate budget: total resident bytes across all uploads.
+		if (slot.residentBytes + data.length > this.#maxResidentBytes) return "over-resident-budget";
+		upload.parts.push(data);
+		upload.bytes += data.length;
+		upload.uploadedAt = Date.now();
+		slot.residentBytes += data.length;
+		return "ok";
+	}
+
+	close(ep: string, up: string): "ok" | "unknown-upload" | "empty" {
+		const slot = this.#slot(ep);
+		const upload = slot.uploads.get(up);
+		if (!upload) return "unknown-upload";
+		if (upload.parts.length === 0) return "empty";
+		upload.closed = true;
+		upload.uploadedAt = Date.now();
+		return "ok";
+	}
+
+	/** Bounded descriptor facts for the named uploads WITHOUT consuming them. */
+	describe(ep: string, refs: ReadonlyArray<string>): Array<{ up: string; contentDigest: string; mimeType: string; length: number }> | "unknown-upload" | "not-closed" {
+		const slot = this.#slot(ep);
+		this.#gc(slot, Date.now());
+		const described: Array<{ up: string; contentDigest: string; mimeType: string; length: number }> = [];
+		for (const ref of refs) {
+			const upload = slot.uploads.get(ref);
+			if (!upload) return "unknown-upload";
+			if (!upload.closed) return "not-closed";
+			const contentDigest = createHash("sha256").update(upload.parts.join("")).digest("hex");
+			described.push({ up: ref, contentDigest, mimeType: upload.mimeType, length: upload.bytes });
+		}
+		return described;
+	}
+
+	/** Reassemble WITHOUT consuming (atomic all-or-nothing validation). */
+	peek(ep: string, refs: ReadonlyArray<string>): NozeliAttachment[] | "unknown-upload" | "not-closed" | "over-aggregate-budget" {
+		const slot = this.#slot(ep);
+		this.#gc(slot, Date.now());
+		let total = 0;
+		const attachments: NozeliAttachment[] = [];
+		for (const ref of refs) {
+			const upload = slot.uploads.get(ref);
+			if (!upload || !upload.closed) return "unknown-upload";
+			if (upload.parts.length === 0) return "not-closed";
+			total += upload.bytes;
+			if (total > this.#maxUploadBytes) return "over-aggregate-budget";
+			attachments.push({ type: "image", mimeType: upload.mimeType, data: upload.parts.join("") });
+		}
+		return attachments;
+	}
+
+	/** Consume exactly the uploads an ACCEPTED request peeked. */
+	commit(ep: string, refs: ReadonlyArray<string>): void {
+		const slot = this.#slot(ep);
+		for (const ref of refs) {
+			const upload = slot.uploads.get(ref);
+			if (!upload) continue;
+			slot.residentBytes -= upload.bytes;
+			slot.uploads.delete(ref);
+		}
+	}
+}
+
+/**
+ * Managed prompt submission chain: no native steer/queue; admission is the
+ * onPromptAdmitted callback; the official typed busy error is injected by the
+ * host patch (bindNozeliBusyError) — never a message-string heuristic.
+ */
+export interface NozeliPromptSession {
+	promptCustomMessage(
+		message: { customType: string; content: string | ReadonlyArray<unknown>; display?: boolean; details?: unknown; attribution?: string },
+		options?: { onPromptAdmitted?: () => void },
+	): Promise<boolean>;
+}
+
+export interface NozeliPromptOutcome {
+	settle: "admitted" | "rejected" | "unknown";
+	reason?: string;
+}
+
+export interface NozeliBusyErrorConstructor {
+	new (message?: string): Error;
+	readonly prototype: Error;
+}
+let boundBusyError: NozeliBusyErrorConstructor | null = null;
+export function bindNozeliBusyError(constructor: NozeliBusyErrorConstructor): void {
+	boundBusyError = constructor;
+}
+
+export async function submitManagedPrompt(
+	session: NozeliPromptSession,
+	kind: { customType: string },
+	text: string,
+	images: ReadonlyArray<NozeliImage> = [],
+	onAdmitted: () => void,
+): Promise<NozeliPromptOutcome> {
+	const content = images.length > 0 ? [{ type: "text", text }, ...images] : text;
+	let admissionFactFired = false;
+	try {
+		const dispatched = await session.promptCustomMessage(
+			{ customType: kind.customType, content, display: true, details: { from: "nozeli-gateway" }, attribution: "user" },
+			{ onPromptAdmitted: () => { admissionFactFired = true; onAdmitted(); } },
+		);
+		if (dispatched) return { settle: "admitted" };
+		return admissionFactFired
+			? { settle: "unknown", reason: "not-dispatched-after-admission" }
+			: { settle: "rejected", reason: "not-dispatched" };
+	} catch (error) {
+		if (!admissionFactFired && boundBusyError !== null && error instanceof boundBusyError) {
+			return { settle: "rejected", reason: "busy-race" };
+		}
+		const message = error instanceof Error ? error.message : String(error);
+		return { settle: "unknown", reason: message.slice(0, 200) };
+	}
+}
+
+/**
+ * Streaming redaction that keeps an unresolved tail across arbitrary chunk
+ * boundaries: only bytes that can no longer be part of a secret are emitted;
+ * finish() flushes the remainder after a final redaction pass.
+ */
+export function createStreamingRedactor(secretPattern: RegExp, maxSecretLength = 512): { push(chunk: string): string; finish(): string } {
+	let pending = "";
+	/**
+	 * A secret may still grow: a match is only emitted once a TERMINATOR (a
+	 * char that cannot extend it) follows, or the stream is finishing. Until
+	 * then everything from the candidate start is held back — no partial
+	 * token, however plausible, is ever emitted.
+	 */
+	const emitSafe = (finishing: boolean): string => {
+		let out = "";
+		for (;;) {
+			secretPattern.lastIndex = 0;
+			const match = secretPattern.exec(pending);
+			if (match) {
+				const after = match.index + match[0].length;
+				const nextChar = pending[after];
+				const terminated = nextChar === undefined ? finishing : !/[A-Za-z0-9_.-]/.test(nextChar);
+				if (terminated) {
+					out += `${pending.slice(0, match.index)}\u0000SECRET\u0000${nextChar ?? ""}`;
+					pending = pending.slice(after + (nextChar === undefined ? 0 : 1));
+					continue;
+				}
+				// May still grow: hold from the candidate start, emit the safe prefix.
+				out += pending.slice(0, match.index);
+				pending = pending.slice(match.index);
+				return out;
+			}
+			// No complete match yet: hold any tail that could still become one.
+			const lastCandidate = Math.max(pending.lastIndexOf("/r/"), pending.length - maxSecretLength);
+			const cut = lastCandidate >= 0 ? lastCandidate : Math.max(0, pending.length - maxSecretLength);
+			out += pending.slice(0, cut);
+			pending = pending.slice(cut);
+			return out;
+		}
+	};
+	return {
+		push(chunk: string): string {
+			pending += chunk;
+			return emitSafe(false);
+		},
+		finish(): string {
+			const flushed = emitSafe(true);
+			secretPattern.lastIndex = 0;
+			const tail = pending.replace(secretPattern, "\u0000SECRET\u0000");
+			pending = "";
+			return flushed + tail;
+		},
+	};
+}
