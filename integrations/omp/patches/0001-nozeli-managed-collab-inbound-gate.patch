+	for (const image of images) {
+		if (typeof image.mimeType !== "string" || image.mimeType.length === 0) return null;
+		if (typeof image.data !== "string" || image.data.length === 0) return null;
+		if (!BASE64_PATTERN.test(image.data) || image.data.length % 4 !== 0) return null;
+	}
+	const canonical = {
+		ep: epoch,
+		kind,
+		text,
+		images: images.map(image => ({ t: image.type, m: image.mimeType as string, d: image.data as string })),
+		tr: target ?? null,
+	};
+	return createHash("sha256").update(JSON.stringify(canonical)).digest("hex");
