+  if (getAgentDir() !== path.join(getConfigRootDir(), "omp")) {
+    throw new Error("Private auth broker requires the Nozeli base agent directory");
+  }
+  await mkdir(getAgentDir(), { recursive: true, mode: 0o700 });
+  await chmod(getAgentDir(), 0o700);
+  const store = await SqliteAuthCredentialStore.open(getAgentDbPath());
+  await chmod(getAgentDbPath(), 0o600);
+  const storage = createBrokerAuthStorage(store);
+  let handle: AuthBrokerServerHandle | undefined;
+  let closing = false;
+  const close = async () => {
+    if (closing) return;
+    closing = true;
+    await handle?.close();
+    storage.close();
+    process.exit(0);
+  };
+  process.once("SIGTERM", () => void close());
+  process.once("SIGINT", () => void close());
+  process.stdin.once("end", () => void close());
+  process.stdin.resume();
+  try {
+    await storage.credentials.reload();
+    const token = randomBytes(32).toString("hex");
+    handle = startAuthBroker({ storage, bind: "127.0.0.1:0", bearerTokens: [token], trustProxyHeaders: false });
+    process.stdout.write(JSON.stringify({ grant: { url: handle.url, token } }) + "\n");
+  } catch {
+    await handle?.close();
+    storage.close();
+    process.stdout.write(JSON.stringify({ error: "Nozeli private auth broker startup failed" }) + "\n");
+    process.exit(1);
+  }
+}
