Nozeli patch 0004 — model management (applies on top of patches/0001..0003).
Purpose: custom-provider model capability metadata (name, reasoning) must
survive the vendored CustomProviderStore round trip into the native models.json
registry (the SDK ModelDefinitionSchema honors both fields natively); session
model selections need an explicit session-side runtime refresh so existing
sessions re-resolve a cached selector after credential/model-source edits
without creating a new session; and the live native per-model thinking levels
(session.getAvailableThinkingLevels, the same authority that clamps thinking)
must be readable for honest capability feedback instead of a fabricated static
tier list. No behavior of unpatched upstream is removed.

--- a/packages/pi-sdk-driver/custom-provider-types.ts
+++ b/packages/pi-sdk-driver/custom-provider-types.ts
@@ -1,4 +1,13 @@
 export interface CustomProviderModelInput {
   readonly id: string;
   readonly contextWindow?: number;
+  /** Optional display name; Nozeli writes service-discovered names, never secrets. */
+  readonly name?: string;
+  /**
+   * Optional user declaration that the model supports reasoning/thinking. The
+   * native model registry honors this field from models.json, so it is real
+   * capability metadata, not UI-only state.
+   */
+  readonly reasoning?: boolean;
 }

--- a/packages/pi-sdk-driver/custom-provider-store.ts
+++ b/packages/pi-sdk-driver/custom-provider-store.ts
@@ -103,6 +103,14 @@ function validateInput(input: CustomProviderInput): void {
     if (model.contextWindow !== undefined && !Number.isFinite(model.contextWindow)) {
       throw new Error(`Model ${model.id} has non-numeric contextWindow.`);
     }
+    if (model.name !== undefined && (typeof model.name !== "string" || model.name.length > 200)) {
+      throw new Error(`Model ${model.id} has an invalid name.`);
+    }
+    if (model.reasoning !== undefined && typeof model.reasoning !== "boolean") {
+      throw new Error(`Model ${model.id} has non-boolean reasoning.`);
+    }
   }
 }
@@ -126,6 +134,12 @@ function toProviderConfig(input: CustomProviderInput): Record<string, unknown> {
       if (model.contextWindow !== undefined) {
         entry.contextWindow = model.contextWindow;
       }
+      if (model.name !== undefined && model.name) {
+        entry.name = model.name;
+      }
+      if (model.reasoning !== undefined) {
+        entry.reasoning = model.reasoning;
+      }
       return entry;
@@ -170,7 +184,16 @@ function readCustomProviders(data: ModelsJson): readonly CustomProviderEntry[] {
             const contextWindow =
               typeof modelConfig.contextWindow === "number" ? modelConfig.contextWindow : undefined;
-            return contextWindow !== undefined
-              ? { id: modelConfig.id, contextWindow }
-              : { id: modelConfig.id };
+            const name =
+              typeof modelConfig.name === "string" && modelConfig.name
+                ? modelConfig.name.slice(0, 200)
+                : undefined;
+            const reasoning =
+              typeof modelConfig.reasoning === "boolean" ? modelConfig.reasoning : undefined;
+            const entry: CustomProviderModelInput = { id: modelConfig.id };
+            if (contextWindow !== undefined) entry.contextWindow = contextWindow;
+            if (name !== undefined) entry.name = name;
+            if (reasoning !== undefined) entry.reasoning = reasoning;
+            return entry;

