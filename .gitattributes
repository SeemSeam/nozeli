# Normalize source files without modifying binary fixtures or generated artwork.
* text=auto
*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.doc binary
*.docx binary
*.xlsx binary
*.pptx binary
*.ttf binary
*.woff binary
*.woff2 binary
