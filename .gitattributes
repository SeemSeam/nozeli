# Normalize source files without modifying binary fixtures or generated artwork.
* text=auto
*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.patch text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.doc binary
*.docx binary
*.xlsx binary
*.pptx binary
*.ttf binary
*.woff binary
*.woff2 binary
# These bytes are pinned in archify-vendor/SOURCES.json, including LICENSE.
apps/desktop/src/agents/managed/archify-vendor/** -text
# The guided demo manifest verifies exact bundled bytes on every platform.
apps/desktop/assets/guided-demo/** -text
